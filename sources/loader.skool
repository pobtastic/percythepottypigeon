@start
@expand=#DEF1(#SKOOLKID(addr)(name)#HTML(<a rel="noopener nofollow" href="https://skoolkit.ca/disassemblies/rom/hex/asm/#EVAL({addr},16,4).html">){name}#HTML(</a>))
@remote=main:$C1DD

@org=$C1DD
; Game Entry Point
@label=GameEntryPoint
c$C1DD LD DE,$C001   ; {Copy #N$0176 bytes of data from #N$053F to
 $C1E0 LD BC,$0176   ; #R$C000@main(RoomBuffer).
 $C1E3 LD HL,$053F   ;
 $C1E6 LDIR          ; }
 $C1E8 LD HL,$FF58   ; {Write #R$FF58@main(Graphics_CustomUDGs) to
 $C1EB LD ($5C7B),HL ; *#SKOOLKID$5C7B(UDG).}
 $C1EE LD HL,$3C00   ; {Write #SKOOLKID$3D00(#N$3C00)
 $C1F1 LD ($5C36),HL ; (CHARSET-#N$100) to
                     ; *#SKOOLKID$5C36(CHARS).}
 $C1F4 LD HL,$E000   ; {Blank #N$1770 bytes of data starting from
 $C1F7 LD DE,$E001   ; #R$E000@main(SpriteBuffer).
 $C1FA LD (HL),L     ;
 $C1FB LD BC,$1770   ;
 $C1FE LDIR          ; }
; Set the lower screen to the default #N$02 lines.
 $C200 LD A,$02      ; {Write #N$02 to
 $C202 LD ($5C6B),A  ; *#SKOOLKID$5C6B(DF_SZ).}
 $C205 JP $5DC0      ; Jump to #R$5DC0@main(Game_Initialise).
